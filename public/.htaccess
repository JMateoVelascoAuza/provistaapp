# Entreobra — hosting estático en Namecheap (Apache / LiteSpeed)
# Se copia a la raíz del sitio junto con el resto de la carpeta out/.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Siempre HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www.entreobra.com → entreobra.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS: el navegador recuerda usar HTTPS. Solo se envía cuando la conexión
  # ya es HTTPS, así no bloquea nada si el certificado todavía no está activo.
  Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS

  # Archivos con hash en el nombre (_next/static): no cambian nunca.
  <FilesMatch "[.-][0-9a-f]{8,}\.(js|css|woff2|webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML, manifest y service worker: siempre la versión nueva.
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(sw|workbox-.*|swe-worker-.*|fallback-.*)\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff2 .woff2
