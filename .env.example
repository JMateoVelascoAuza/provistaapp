# URL del Google Apps Script (apps-script/Code.gs) publicado como
# "Aplicación web" en la hoja del cliente. Termina en /exec.
# La usan los dos formularios: el de acceso anticipado de la landing y
# la página de registro de productos (/registro/). No es secreta: va
# dentro del sitio publicado.
#
# Para producción: copia este archivo como .env.production.local, pega
# la URL y corre `npm run build:hosting`.
# Sin URL, todo sigue funcionando en local: los formularios terminan en
# WhatsApp / CSV (o en los logs del servidor con `npm run dev`).
NEXT_PUBLIC_APPS_SCRIPT_URL=

# Solo si algún día se publica con servidor (Vercel u otro): URL a la que
# /api/registro reenvía el formulario. Si está vacía usa la de arriba.
GOOGLE_SHEETS_WEBHOOK_URL=
